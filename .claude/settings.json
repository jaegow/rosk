{
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run check:*)",
      "Bash(npm run lint)",
      "Bash(npm run lint:*)",
      "Bash(npm run lint.types)",
      "Bash(npm run lint.types:*)",
      "Bash(npm run test:unit)",
      "Bash(npm run test:unit:*)",
      "Bash(npm run test:browser)",
      "Bash(npm run test:browser:*)",
      "Bash(npm run test:all)",
      "Bash(npm run test:all:*)",
      "Bash(npm run validate)",
      "Bash(npm run check:skill-trees)",
      "Bash(node scripts/check-skill-trees.js)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git merge-base:*)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse:*)"
    ],
    "deny": [
      "Read(./.claude/settings.local.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/skill-freshness.js\" session", "timeout": 15 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/skill-freshness.js\" prompt", "timeout": 15 }] }
    ],
    "PreToolUse": [
      { "matcher": "Skill", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/skill-freshness.js\" skill", "timeout": 15 }] }
    ]
  }
}
